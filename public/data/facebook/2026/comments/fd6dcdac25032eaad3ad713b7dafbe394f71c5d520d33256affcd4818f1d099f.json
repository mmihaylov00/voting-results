{"version":1,"collectionSha256":"d7a93b810c37eed5a09d9d289b64e2a90e23252bb9ed7d21a2ba2467443d79a2","postId":"post:1582826077192767","comments":[{"id":1,"parentId":null,"text":"Не мога да му. гледам муцуната на тоя!","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":2,"parentId":1,"text":"недей толкова е лесно","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":3,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":4,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":5,"parentId":null,"text":"Тоя да върви да става манекен, не президент! Ма май и за това не става! Скратиха се сериозните мъже, та опряхме до него!","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":"Негодни сте вие","truncated":false,"gyurov":"unclear","yotova":"unclear"},{"id":7,"parentId":null,"text":"Никога за него","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":8,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":9,"parentId":null,"text":"ТОЗИ НЕ СТАВА !!!","truncated":false,"gyurov":"critical","yotova":"not-mentioned"}]}
