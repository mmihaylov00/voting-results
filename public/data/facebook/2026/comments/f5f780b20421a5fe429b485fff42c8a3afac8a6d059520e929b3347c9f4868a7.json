{"version":1,"collectionSha256":"ab3e4396191538847e3d1c3e11fa882385b2aa6c71e9f5649777ef44ff53fb9c","postId":"post:pfbid0VYwjVLzXpkkkERa8B8nj2WYinTRjHSpMdpuWSyDxxZJhLRDPWNATZtj8DDT8ctk2l","comments":[{"id":1,"parentId":null,"text":"[връзка]\n[връзка]\nАналоговият “лидер на дясна партия” Дядо Йоцо от Банкя цифрово подкрепи Гюров! | BNEWS","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":2,"parentId":null,"text":"Сглобката се възроди ,с позволението на месията !И ако другата сеедмица народа не излезе да гласува има шанс да се върнат на бял кон !","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":3,"parentId":null,"text":"Барек , ти от къде знаеш кой за кого е гласувал ? Мадуро ли ти каза бе лъжльо ? Нали вотът е таен .","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":4,"parentId":null,"text":"Според мен фърли за [име], но тука на снимката търси [име].","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":5,"parentId":null,"text":"Тоя бандит нали не се интересуваше от тези избори... лисугер гнусен!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":7,"parentId":null,"text":"По точно Костадинов","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":8,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":9,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":10,"parentId":null,"text":"Преко сили на борба със софтуера....","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":11,"parentId":3,"text":"А ня теб Путкин ли ти каза че не е така.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":12,"parentId":3,"text":"Не бъркай Путкин с Дудука  Коментарът е на всепризнатия и лъжлив ДУДУК .","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":13,"parentId":3,"text":"Напоследък казва самата истина.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":14,"parentId":6,"text":"Не ! Рундьо ще отиде , за благодарност , защото той плащаше и подкрепяше кампанията му .","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":15,"parentId":null,"text":"Болтове с отвертка развиваше на предходните избори!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":16,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":17,"parentId":null,"text":"Ще се хванат за палците във втория рунд! Продажни отрепки!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":18,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":19,"parentId":6,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":20,"parentId":6,"text":"Аз няма за какво да му благодаря , не ме е спонсорирал и нямам връзки с олигарси .","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"}]}
