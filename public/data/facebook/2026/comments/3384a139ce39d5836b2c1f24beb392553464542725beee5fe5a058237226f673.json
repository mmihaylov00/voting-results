{"version":1,"collectionSha256":"d7a93b810c37eed5a09d9d289b64e2a90e23252bb9ed7d21a2ba2467443d79a2","postId":"post:pfbid02PjhhvHUKazdRWLaoBwbzKiEQb7hM945KZtAMcp4hFGrR8mDfyKzygx4oTCznvw74l","comments":[{"id":1,"parentId":null,"text":"Депутатка на Пеевски: Гласувайте за номер 4, за да подкрепите [име]! | BNEWS","truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":2,"parentId":null,"text":"Депутатка на Пеевски: Гласувайте за номер 4, за да подкрепите [име]! | BNEWS","truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":3,"parentId":null,"text":"Хахахха, трябва да си най-големия ттъпак да се хванеш на Тази пропаганда","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":4,"parentId":null,"text":"Днес членовете на комисиите от дпс в кв.Надежда също получиха смс- и","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":5,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":"Кой ще се хване на тази мадама ние ще гласуваме за Йотова","truncated":false,"gyurov":"not-mentioned","yotova":"supportive"},{"id":7,"parentId":null,"text":"Българите мюсюлмани, гласуващи за Гюров, знаят ли, че той подкрепя политиката на Израел и Америка в Палестина и Иран и не ги смята за агресори?","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":8,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":9,"parentId":null,"text":"Голям кеф ще е Йотова да спечели ! В понеделник ще е велико ..","truncated":false,"gyurov":"not-mentioned","yotova":"supportive"},{"id":10,"parentId":null,"text":"Тази депутатка е за разследване.Проверка на ЦИК за гласовете и от м.04.т.г.Смекване на имунитета и съд за агитиране в забранения ден.Вярное! Шефовете от тази партия наред бъдат на своите хора да гласуват за посочения от тях човек","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":11,"parentId":3,"text":"истина е и смс- и пускат","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":12,"parentId":3,"text":"Точно така!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":13,"parentId":3,"text":"хаха...така и Пеевски се смееше срещу Асен Василив и сие!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":14,"parentId":3,"text":"очаквано беше да се организирате с тази пропаганда","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":15,"parentId":3,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":16,"parentId":3,"text":"на кого профилната?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":17,"parentId":3,"text":"Профилната снимка на цитираната госпожа, и снимката от \"Съобщението\" са различни.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":18,"parentId":3,"text":"случвало се е и при мен , когато сменя профилна..В случая може да е фалшиво , но днес им пращаха смси.Ако отворите във фейсбук масово агитират за Гюров","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":19,"parentId":3,"text":"това е страхотно. Гюров ще е президента","truncated":false,"gyurov":"supportive","yotova":"not-mentioned"},{"id":20,"parentId":3,"text":"истинае,истина,не се правете на ударени","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":21,"parentId":3,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":22,"parentId":3,"text":"пробвайте някога да водите нормален разговор. Ще видите, че не боли. Пък и вие няма да сте смятан за пропаднал дивак.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":23,"parentId":3,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":24,"parentId":3,"text":"наздраве чиче!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":25,"parentId":4,"text":"покажи снимки","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":26,"parentId":4,"text":"покажете снимки","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":27,"parentId":4,"text":"е аз не съм от дпс как да покаэа\n😄","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":28,"parentId":4,"text":"който е да покаже","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":29,"parentId":4,"text":"и да покажат ще кажете фалшиви са.\n😂","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":30,"parentId":4,"text":"то ще се разбере утре в 01:00 часа в сайта на ЦИК","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":31,"parentId":4,"text":"именно","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":32,"parentId":6,"text":"каде видяхте мадама .","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":33,"parentId":6,"text":"хващат и се много- всички овце от долината на дългите гащи","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":34,"parentId":6,"text":"Извенявам се","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":35,"parentId":null,"text":"Гюров днес изгледал дебата си с Йотова и решил в неделя да гласува за нея \n🙂","truncated":false,"gyurov":"critical","yotova":"neutral"},{"id":36,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":37,"parentId":null,"text":"Овцата сие овца кадето е подкараш там ще ходи.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":38,"parentId":null,"text":"Мишка е тази","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":39,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":40,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":41,"parentId":null,"text":"Неграмотница и продажница!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":42,"parentId":null,"text":"Как пък не, хаиде марш","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":43,"parentId":null,"text":"Народните представители са избрани да представляват гражданите, а не да използват положението си, за да агитират и да налагат политически предпочитания. Всеки човек има право сам да решава за кого да гласува. Депутатският пост не е лична трибуна за политически натиск. Уважението ","truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":44,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":45,"parentId":7,"text":"не не е точно така само тия боклуци кадето са покрай крадливите кметове","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":46,"parentId":7,"text":"знаят само да ядат кебчета\n🐏","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":47,"parentId":7,"text":null,"truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":48,"parentId":7,"text":"Всички подкрепят Еврейте,комуниста Радев постоянно се покланя на Еврейте със шапчицата на главата!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":49,"parentId":7,"text":null,"truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":50,"parentId":7,"text":"Българите мюсюлмани е грешен израз!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":51,"parentId":7,"text":"ти за кво им говориш а те им бил проблема според един от коментиращите по долу че ги наричаме българи мюсюлмани, сякаш тоова е по важно от това че подържат подръжбици на евреите","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":52,"parentId":7,"text":"те още са във възродителния процес не са дорасли за да се интересуват от подобна политика!!!!!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":53,"parentId":7,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":54,"parentId":7,"text":null,"truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":55,"parentId":7,"text":"Хаха ,даа същата жена е .","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":56,"parentId":7,"text":"Жалко за хората \n🤔\n🤔\n🤔","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":57,"parentId":7,"text":"може само че в сънищата ти","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":58,"parentId":7,"text":"За кое казваш че може само в сънищата ми?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":59,"parentId":8,"text":"Какъв изказ само! Абсолютна простащина!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":60,"parentId":8,"text":"Оближи го мазния зад....к на Нереза","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":61,"parentId":8,"text":"прав е изразът и точен","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":62,"parentId":8,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":63,"parentId":8,"text":null,"truncated":true,"gyurov":"critical","yotova":"critical"},{"id":64,"parentId":8,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":65,"parentId":8,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":66,"parentId":8,"text":"няма да псуваш боклук! Ако искаш да коментираш политиката си е твое право, но да псуваш цял етнос затова че си тъп и прост е проблем за теб!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":67,"parentId":8,"text":"Аз да ти ЕП майчина","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":68,"parentId":8,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":69,"parentId":8,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":70,"parentId":8,"text":"А вие господине не обиждате ЦЯЛАТА общност вие по онова време не сте били да знаете дали сме се предали или е било като преди 71година.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":71,"parentId":8,"text":"Дърпай подлого гнусна","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":72,"parentId":8,"text":"седи мирен [име]","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":73,"parentId":8,"text":"Ще го кажеш на майка си","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":74,"parentId":8,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":75,"parentId":8,"text":"На майкати носи здраве от мен.....","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":76,"parentId":8,"text":"Предали вярата? Само през комунизмът имаше едно насилствено такова нещо,но през останалите [скрито] години сме си били верни.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":77,"parentId":8,"text":"Не обиждай ако имаш разум но нямаш,назад в историята предателите си личат.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":78,"parentId":8,"text":"Твоите обиди говорят много повече за теб, отколкото за помаците. Да нападаш цял народ заради произхода и вярата му е проява на невежество, а не на сила. Аз няма да се срамувам от корените си, за да се чувстваш ти значим. Запомни: достойнството не се определя от чужд","truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":79,"parentId":8,"text":"абе мамицата ти мръсна, каква вяра са предали ","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":80,"parentId":8,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":81,"parentId":9,"text":"Щом ДПС подкрепят Гюров Йотова няма никакъв шанс!","truncated":false,"gyurov":"neutral","yotova":"neutral"},{"id":82,"parentId":9,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":83,"parentId":9,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":84,"parentId":9,"text":"На майка си Подлого гнусна,ти да кажат за кого да гласуваш що за тъпанар трябва да бъдеш!!????","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":85,"parentId":9,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":86,"parentId":9,"text":"Имайте смелостта поне да си покажете мутрите шибани страхливи мишки!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":87,"parentId":9,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":88,"parentId":9,"text":"Цените още ще се покачват и ще гладувате кучета гладни,мен ме боли уя аз изкарвам доста евра!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":89,"parentId":10,"text":"А не трябва да е така .Нека тези хора се осъзнаят най накрая .Ако така правят,значи наистина нямат собствено мнение а позволяват да ги водят за носа.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":90,"parentId":36,"text":"много маймуни ще станат на този клон....ще го счупят","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":91,"parentId":40,"text":"А защо не?!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":92,"parentId":null,"text":"Министерство на вътрешните работи","truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":93,"parentId":null,"text":"Герберите също имат инструкции....","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":94,"parentId":null,"text":"НИКОГА","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":95,"parentId":null,"text":"Тотална олигофрения. Кочината жалка се разпада. Време е за хотел пандиз","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":96,"parentId":null,"text":"Никога \n🤮","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":97,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":98,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":99,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":100,"parentId":null,"text":"Ама, че глупости \n😂\n😂\n има доста коментатори, които са се вързали!\nТа, до когото е адресирана въпросната агитация?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":101,"parentId":null,"text":"Мръсници деребеи лъжат народа","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":102,"parentId":null,"text":"Никога!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":103,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":104,"parentId":null,"text":"Не","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":105,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":106,"parentId":null,"text":"Комунистическите номера край нямат","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":107,"parentId":null,"text":"Ужас","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":108,"parentId":null,"text":"Радев се опита да арестува Хората на Пеевски и сега ще изгуби изборите \n😂\n😂\n😂","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":109,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":110,"parentId":105,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"}]}
