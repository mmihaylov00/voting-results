{"version":1,"collectionSha256":"6f731621aa7c0dfe30f562d52469d0ac47832acffde217c6ec47f56d896a5310","postId":"post:pfbid02tSwQMoJwCoCrCmufVbnhSct2RywH5uGBxKwZ2B1SbC1mQ1F9oEqM111qJ2LL1cUZl","comments":[{"id":1,"parentId":null,"text":"Докато ООН се наумува, пък после да действа- ще остане ли някой жив там?\nТолкова измислена институция, трябваше ли да мълчи до сега или не бе политкоректно  до преди месец?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":2,"parentId":null,"text":"Да ги изключат от ООН, като не им спазват правилата... Мижава дъ-жава си прави каквото иска и никой не може да я озапти...","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":3,"parentId":null,"text":null,"truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":4,"parentId":null,"text":"Ako imashe oon nyamashe da ima voini","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":5,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":"Празни думи. ООН трябва да се закрие.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":7,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":8,"parentId":null,"text":"Действия трябват срещу световния терорист Исраел, не декларации!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":9,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":10,"parentId":null,"text":"Докато краварите ги слушат така ще е","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":11,"parentId":1,"text":"Бре толкова акъл на едно място. ще не погледнеш какъв е прираста на насешението за две години. Глупаци, ислямистите ви се хилят зад гърба.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":12,"parentId":3,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":13,"parentId":3,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":14,"parentId":6,"text":"В ООН ТРЯБА ДА ИМА САМО КУЧКИ КАТО ТЕБЕ","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":15,"parentId":8,"text":"\"Световният терорист\" Израел ти е изпил мозъка. По-глупави от българите няма.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":16,"parentId":9,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":17,"parentId":null,"text":"ООН са абсолютен кенеф !!!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":18,"parentId":null,"text":"Слуги на сатаната дяволски изчадия \n😡","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":19,"parentId":null,"text":"ИМПОТЕНТНОСТ НА ООН И ИЗОБЩО.\nАКО ИМАШЕ НАИСТИНА ОРГАНИЗАЦИИ ЗА МИР И СПРАВЕДЛИВОСТ, ИЗРАЕЛ ЩЕШЕ ДА БЪДЕ СПРЯН ОЩЕ В НАЧАЛОТО.\nБУДАЛКАТ НИ ЧЕ ИМА ОРГАНИЗАЦИИ, КОИТО СЕ БОРЯТ ЗА МИР И СПРАВЕДЛИВОСТ.\nПЪЛНИ ГЛУПОСТИ.ЧОВЕЧЕСТВОТО Е ПРИСПАНО И ИМПОТЕНТНО ЗА КАКВОТО И ДА БИЛО. ЗА СОБСТ","truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":20,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":21,"parentId":null,"text":"Иии какво от цялата работа????\nКучето лае керванът върви..\nДокато не го вкарат до живот този изверг нещата ще отиват на още по зле.\nВсички  тези изроди се чувстват безнаказани и това е истината..","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":22,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":23,"parentId":null,"text":"ООН били обвинили Израел, че са сатанисти. Но Израел сами доказаха,че са сатанисти чрез действията си.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":24,"parentId":null,"text":"Стига вече сте убивали.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":25,"parentId":null,"text":"Какво чака ООН, да се задейства!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":26,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":27,"parentId":9,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":28,"parentId":25,"text":"ами какво да чака, всички виждат, че са с промити мозъци.Днес Еди от министрите им пусна видео където показа,кафе,храна, плодове,маслини хляб и каза в прав текст и радостен , че им ги е спрял,че го обвинят, че е детеубиец,но не му пука какво мисли света. Та като ги","truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":29,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":30,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":31,"parentId":null,"text":"Няма нищо верно в това което сте написали . Нито изнасилвания нито геноцид","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":32,"parentId":null,"text":"Време беше","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":33,"parentId":null,"text":"ООН!\n😂\n😂\n😂\n😂\n🤣\n🤣\n🤣\n🤣\n🤣\n😂\n😂\n😂\n😂\n🤣\n🤣\n🤣\n🤣\n🤣\n😂\n😂\n Кой се интересува от революциите на ООН?! Филанкишията или Сульо и Пульо?! Тая организация требва да изчезне. Безплодна и безполезна е. Примери дал Господ.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":34,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":35,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":36,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":37,"parentId":31,"text":"Нито ти си нормална....\nЦял свят го знае и го признава , само ти не вярваш","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":38,"parentId":31,"text":"а ти в кой свят живееш ,земи се поразтършувай малко ,[обида] \n🤮\nили просто така ти се иска да говориш","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":39,"parentId":null,"text":"Явно обвиненията на ООН вече не струват и пукната пара...","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":40,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":41,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":42,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":43,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":44,"parentId":null,"text":"ООН е исламска организация. Дано Тръм им резне финснсирането.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":45,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":46,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":47,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":48,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":49,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":50,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":51,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":52,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":53,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","y