{"version":1,"collectionSha256":"d46d0c538375d98f3652626c8bb4389128a07c50a674d11fff526e8c4cb749c4","postId":"post:pfbid01K7wZwET4jScNQVGcGEEB4CzSCWzgGXwwwACQpZAeqK5BTVQKs7nwkXvt6k1eEgGl","comments":[{"id":1,"parentId":null,"text":"[връзка]\n[връзка]\nСкандал преди балотажа: Щабът на Андрей Гюров даде Румен Радев на ЦИК за незаконна агитация през Министерския съвет","truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":2,"parentId":null,"text":"По повод \n🪖\n войнолюбците и \n🕊️\nмиротворцитеПонеже в кампанията за президент стана актуално да се коментира кой кандидат иска мир и кой е войнолюбец, нека да стане ясно какво е подписал г-н Гюров на 30 март 2026 г. в качеството му на служебен премиер:- Споразумение за 10-годишно ","truncated":true,"gyurov":"critical","yotova":"neutral"},{"id":3,"parentId":null,"text":null,"truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":4,"parentId":null,"text":"Комсомлоския секретар и мумията\n😉","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":5,"parentId":null,"text":"Гадове долни и вие не сте желани!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":"Цялата им  кампания е само лъжи,доноси,компромати и провокации,хората вече ви разбраха що за екип  сте и не са толкова глупави  да гласуват за вас.\n🤮","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":7,"parentId":null,"text":"Гюро в вторник си тръгва за Украйна ...","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":8,"parentId":null,"text":"Смешник тоя [обида] ще управлява българия тежко ни","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":9,"parentId":null,"text":"Ще пие в скута кафе на Пеевски отново","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":10,"parentId":null,"text":"На калпавия водолаз, водораслите му пречат, мога и в друг вариант, досещате се","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":11,"parentId":2,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":12,"parentId":3,"text":"Госпожо, Какво прозрение \n😳\n Не пишете глупости, защото някои глупаци могат да повярват на лъжата Ви.","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":13,"parentId":3,"text":"[лично твърдение]А Йотова как ще накарате да не помилва наркобароните.","truncated":false,"gyurov":"neutral","yotova":"critical"},{"id":14,"parentId":4,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":15,"parentId":4,"text":"Тебе пък кой те би по главата да си показваш простотията!?!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":16,"parentId":3,"text":null,"truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":17,"parentId":3,"text":null,"truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":18,"parentId":3,"text":null,"truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":19,"parentId":3,"text":null,"truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":20,"parentId":4,"text":"И ти ли си прост бе копейчице!?!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":21,"parentId":4,"text":"Аз поне съм нещо.\nА за твойте писаници.\nПрез хуя си ми.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":22,"parentId":4,"text":"С тая простотия няма как да промениш факта че си прост!?!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":23,"parentId":4,"text":"Всеки има право на грешно мнение.\nА Аз нямам повече време за теб.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":24,"parentId":4,"text":"Сигурен съм че можеш да покажеш още простотии, тъкмо беше се наел!?!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":25,"parentId":4,"text":"[име] вижте резултата от разумните Българи.\nМного здраве.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":26,"parentId":4,"text":"И как резултата ще промени факта че си прост!?!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":27,"parentId":4,"text":"такива идиоти като теб, например\n😉","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":28,"parentId":4,"text":"С тая простотия ли ще променяш факта че си прост бе копейчице!?!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":29,"parentId":5,"text":"Кой Ви каза?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":30,"parentId":5,"text":"Защо някой трябва да ми каже?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":31,"parentId":5,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":32,"parentId":6,"text":"Кое е лъжа бе копейчице, я да чуем!?!","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":33,"parentId":10,"text":"Ама разбира се че можеш, от прост човек простотии да искаш!?!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":34,"parentId":null,"text":"Още от сега са НЕКЪДЪРНИЦИ...?!!!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":35,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":36,"parentId":null,"text":"Е що за изказване? Такива са поддръжниците на Гюров! Безмозъчни циници","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":37,"parentId":null,"text":"На коча мъдята се клатят!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":38,"parentId":null,"text":"Тъпи копелета. Изроди. Вие за клошари ставате само, кой ви подлъга,че ставате за нещо друго","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":39,"parentId":null,"text":null,"truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":40,"parentId":null,"text":"Неви ли срам. Тоя вице. Досега на кому държа.?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":41,"parentId":null,"text":"Боклуци","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":42,"parentId":null,"text":"МЪРШИ.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":43,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":44,"parentId":null,"text":"Чудят се какъв компромат още да измислят.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":45,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":46,"parentId":null,"text":"Май пак слошо започваме и пак компромати !","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":47,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":48,"parentId":null,"text":"простият мунчо друго не знае","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":49,"parentId":null,"text":"Трябва да ни води един еродиран ,благороден и умен човек !","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":50,"parentId":null,"text":"Нагли смешници!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":51,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":52,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":53,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":54,"parentId":48,"text":",верно,че си прост по рождение \n😀","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":55,"parentId":null,"text":"Тоя щаб са подлога Но в неделя ще бъдат пътници","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":56,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"}]}
