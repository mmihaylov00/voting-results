d"},{"id":14,"parentId":null,"text":"Кой не е минал, на него не му е отказала да говори","truncated":false,"gyurov":"not-mentioned","yotova":"unclear"},{"id":15,"parentId":null,"text":"И ние не искаме да говорим с нея","truncated":false,"gyurov":"not-mentioned","yotova":"unclear"},{"id":16,"parentId":null,"text":"Чебурашка е с фешън прическа \n😂","truncated":false,"gyurov":"not-mentioned","yotova":"unclear"},{"id":17,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"unclear"},{"id":18,"parentId":null,"text":"Аз съм ЕЛФ","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":19,"parentId":null,"text":"Чувствам се споменат...ама нещо не ми е много яко, че тя го каза..","truncated":false,"gyurov":"not-mentioned","yotova":"unclear"},{"id":20,"parentId":19,"text":"Ама поне и бъркаме...някъде!\n😂","truncated":false,"gyurov":"not-mentioned","yotova":"unclear"},{"id":21,"parentId":18,"text":"Не, аз съм Елф!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"}]}
