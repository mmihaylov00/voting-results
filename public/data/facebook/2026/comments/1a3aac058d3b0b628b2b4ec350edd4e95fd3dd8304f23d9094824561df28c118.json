{"version":1,"collectionSha256":"d46d0c538375d98f3652626c8bb4389128a07c50a674d11fff526e8c4cb749c4","postId":"post:pfbid02xBHQG3oNTv5Fn74pzZ2znxx7XGj8CEvZ6j6TEEih8kCyYKKQkftHhWepqmw62Ttvl","comments":[{"id":1,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":2,"parentId":null,"text":"[име] се надява на нещо , и е символ на бай Ганьо ...","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":3,"parentId":null,"text":"Когато единият пръст от ръката на [име] сочи напред другите три сочат към него.  Какво общо има той с Благоевград, че ще има мнение за [име]?  На времето го избраха за кмет на Дупница, за да не е лекар у болницата.  Решиха, че кметуването му ще е по-безопасно от докторлъка му.","truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":4,"parentId":null,"text":"[име] - символът на демокрацията!? \n😁\n😁\n😁\n😁\nЕгати вица","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":5,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":"Те така я разбираме демокрацията. Идва държавния глава и ти се криеш, щото си от друга партия.","truncated":false,"gyurov":"not-mentioned","yotova":"neutral"},{"id":7,"parentId":null,"text":"Пенюга тове е пън!!!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":8,"parentId":null,"text":"Ела му го кажи в очите БЕ?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":9,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":10,"parentId":null,"text":"Е голяма култура е показал [име]. Съвременният байганьо.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":11,"parentId":1,"text":"Благодарим за мнението!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":12,"parentId":1,"text":null,"truncated":false,"gyurov":