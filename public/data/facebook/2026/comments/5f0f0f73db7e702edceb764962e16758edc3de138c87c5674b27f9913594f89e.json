{"version":1,"collectionSha256":"d46d0c538375d98f3652626c8bb4389128a07c50a674d11fff526e8c4cb749c4","postId":"post:pfbid02YEnaiZjs1moWfKzzNhGeRnJYkN3C6Y4FgiUStiaEH1NEP5Yq8mv5iPFnvXUQW7HVl","comments":[{"id":1,"parentId":null,"text":"И каква основателна причина имаше, за да не ги вдигнете и унищожите \"братските\"-руски дронове? Сетих се.\nЩяха да ви се скарат от Кремъл, че сте спасили кораба.\nМръсна комунистическа измет си ти Радев, ти и всички около теб!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":2,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":3,"parentId":null,"text":"Но понеже сте човечни и за мира̀, рискувахте живота на моряците! По-долни мекерета от вас няма!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":4,"parentId":null,"text":"Правилно ли разбирам: дроновете са на 4 мили от границата и мунчо е щял да ги вдигне -като пресекат? Тази военна техника ,с която щеше ги сваля , телепортира ли се?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":5,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":7,"parentId":null,"text":"Koi samoleti be? \n😂","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":8,"parentId":null,"text":"Fatmaka Radev e Ruska podloga","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":9,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":10,"parentId":null,"text":"Мунчо КАПУТ\nПОЗОР за управляващите\nДостойнството е Бюлетина Номер 4\nПълен успех\nДа живее България!","truncated":false,"gyurov":"supportive","yotova":"not-mentioned"},{"id":11,"parentId":2,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":12,"parentId":6,"text":"той няма самолет ,а отвес.\n😅","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":13,"parentId":null,"text":"Радев: \"Ако си свалиш гащите навреме, няма да се насе.реш\"","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":14,"parentId":null,"text":"Сигурно сме били в ступор, защото не спазват меморандума на мунчо.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":15,"parentId":null,"text":"Предател,дезертьор,кръвта на всички загинали е по ръцете ти.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":16,"parentId":null,"text":"Искахме ама нямахме желание","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":17,"parentId":null,"text":"Започвам да се съмнявам че този някога е бил военен\n🤣\n🤣\n🤣\nедин редник има повече мозък","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":18,"parentId":null,"text":"Да ги посрещат като цар Самуил ли? Те нямат въоръжение, само за паради са наще  ввс другари на премиера.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":19,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":20,"parentId":null,"text":"Радев и Йотова са срам и позор! Лъжа след лъжа…\n🤡\n🤡","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":21,"parentId":null,"text":"Щяхте да дигнете самолета, ма по байтошово време\n😂\n😂","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":22,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":23,"parentId":null,"text":"Как така бойни самолети?\nАми Те, вдигнатите военни самолети са ги докладвали, но май с нещо друго трябва да се спират /унищожават/","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":24,"parentId":null,"text":"Щяхме \n😂\n😂\n😂\n😂","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":25,"parentId":null,"text":"Тов не може да си вдигне гащите … самолета ще вдигне …","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":26,"parentId":null,"text":"Руски ватник, така ли България ще пази международния търговски трафик от който България е силно зависима: като оставяме руските дронове да потапят търговски кораби в ИИЗ на България?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":27,"parentId":null,"text":"предстои да видим","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":28,"parentId":null,"text":"Yes, we are not war lovers \n😂","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":29,"parentId":null,"text":"Если бы у бабушки были яйца,то она была бы дедушкой.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":30,"parentId":null,"text":"Тоя само като го видя и...\nКакто и да е. Пиша, за да прокараме един необорим факт: мое си говорят за вкарване на България във война, но преди пп да станат \"спасители\" не помня да е имало дронове. Случайност? Лош пи ар? Заплахи, че ако не стане йотова президент, ще ни го върнат в ","truncated":true,"gyurov":"not-mentioned","yotova":"unclear"},{"id":31,"parentId":null,"text":"британски дронове","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":32,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":33,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":34,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":35,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":36,"parentId":null,"text":"За колко време щяха да стигнат дроновете,примерно до Варна и кога щяхте да пратите авиацията \n😁","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":37,"parentId":null,"text":"Няма да стреляте по братските дронове","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":38,"parentId":null,"text":"Артисче ,откажете се от президенската пенисия?","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":39,"parentId":null,"text":"Трибестан ли приехме на въоръжение?\n😏","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":40,"parentId":null,"text":"Жалък, та чак за заплюване.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":41,"parentId":null,"text":"Малийййй","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":42,"parentId":null,"text":"верваме му.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":43,"parentId":null,"text":"Поредната лъжа! Но пък държавата икономисва скъпо авиационно гориво...","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":44,"parentId":null,"text":"Само така може да спре дрон румбата","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":45,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":46,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":47,"parentId":null,"text":"Не трябва да имаме свръх очаквания...","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":48,"parentId":null,"text":"То тъй се вдига самолет","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":49,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":50,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":51,"parentId":null,"text":"Ще дигне гълъбите тоя тъпунгер скоро.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":52,"parentId":null,"text":"Да ве","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":53,"parentId":null,"text":"Ако влязат, ще каже, че първо трябва да знаят чии са преди да ги гръмнат \n🤣\n Баси военните имаме. Не ни трябват пари за армия, а мъже...","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":54,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":55,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":56,"parentId":null,"text":"Отиваш си, зИлен чорапогащник!\nОтиваш си...\nКакто дойде, така и ще си заминеш!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":57,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":58,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":59,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":60,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":61,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":62,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":63,"parentId":61,"text":"Много обича руска ласка","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":64,"parentId":62,"text":"дезертьора кара военен самальот,тази версия на продукта при него няма да сработи.Но съдейки по това,което фантазира в телевизора,капацитета му е на осмокласник,както и на онази част \"български\" военни,завършили с измислени оценки и връзкарщината на Онова врем","truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":65,"parentId":62,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":66,"parentId":62,"text":"Проба/грешка,после ще му мислим.Може да потърси помощ от Амнистираните,те имат от всичко.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":67,"parentId":null,"text":"Да се скрие Радев!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":68,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":69,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":70,"parentId":null,"text":"То , това не смешно , но всъщност е страшно смешно!!!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":71,"parentId":null,"text":"Дреме му на тоя пуяк, че може да умрат хора. Няма такъв дебил честно.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":72,"parentId":null,"text":"И какъв е проблема да ги вдигне и когато дроновете са в български води да ги неутрализират.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":73,"parentId":null,"text":"Тоз само го возят!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":74,"parentId":null,"text":"късно е, либе, за китка!\n🤣","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"}]}
