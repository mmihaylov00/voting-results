{"version":1,"collectionSha256":"d7a93b810c37eed5a09d9d289b64e2a90e23252bb9ed7d21a2ba2467443d79a2","postId":"post:pfbid02yYngwbFJKYGVPJiqoahxFCb3cXeW7T9QjGz93rwXjiustzsoUTefJXQzMxkgkuUel","comments":[{"id":1,"parentId":null,"text":"Първата жена президент в България е истински позор - и за институцията, и за пола ни! Злобна, лъжлива, с изкривено от агресия лице, та чак тръпки да те побият… Масата обаче, си я брои за някаква победителка!… Щеше да победи! Ако това беше някаква извратена лига за мазни женски бо","truncated":true,"gyurov":"not-mentioned","yotova":"critical"},{"id":2,"parentId":null,"text":"\"Здраейти\n❤\nАсам Буратина Йотовна и от два часа не съм лъгала.\"","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":3,"parentId":null,"text":"Тази червена фуста лъже най-долно и манипулативно! [лично твърдение] Защо не обясни кой финансира нейната кампания?\n🤔","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":4,"parentId":null,"text":"Хвана ме срам,че тази зла и безочлива жена е президент на България!","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":5,"parentId":null,"text":"Не с лошото, че тя много се засяга. \n😃\n нека само порозовее като прогресивно растяща дива роза. \n🫠","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":6,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":7,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":8,"parentId":null,"text":"Комунисти, сър!?","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":9,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":10,"parentId":null,"text":"Лъжите са от Гюров украинеца и ДБ !","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":11,"parentId":1,"text":"Злобната си ти . Победата е за Йотова !","truncated":false,"gyurov":"not-mentioned","yotova":"supportive"},{"id":12,"parentId":1,"text":"Победителка сред фльорците и лъжците.","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":13,"parentId":1,"text":", бе не аз бях с изкривена от злоба муцуна, с пяна на устата, снощи по телевизора…","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":14,"parentId":2,"text":"А Гюро не лъже той е света вода ненапита","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":15,"parentId":2,"text":"Не! Гласувай с 4, ми амор\n❤","truncated":false,"gyurov":"supportive","yotova":"not-mentioned"},{"id":16,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":17,"parentId":null,"text":null,"truncated":false,"gyurov":"unreviewed","yotova":"unreviewed"},{"id":18,"parentId":null,"text":"30-ти октомври мина,не казаха,дали ще влизат в коалицията с дронове","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":19,"parentId":null,"text":"Пълно е с лъжи за Йотова !","truncated":false,"gyurov":"not-mentioned","yotova":"neutral"},{"id":20,"parentId":null,"text":"БАБО ЙОТОВА  ХАЙДЕ ОСТАВКА","truncated":false,"gyurov":"not-mentioned","yotova":"critical"}]}
