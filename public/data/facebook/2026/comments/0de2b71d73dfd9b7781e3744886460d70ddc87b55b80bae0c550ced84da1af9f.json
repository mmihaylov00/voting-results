{"version":1,"collectionSha256":"2fe8d162ce20d45ab651a161eddfebc32fbcb930f651ae8e74ce2598f5bac370","postId":"post:pfbid0DKLNwwfhRLsUCAvwvSTVqxjXo14Ybg7hQBM4QkapDncqik1b8BY8ryNsYbzq47XRl","comments":[{"id":1,"parentId":null,"text":"Доживяхме да видим Кирил Петков от премиер с помощни колелета до “сив кардинал” зад Гюров и производител на военни дронове за Украйна |","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":2,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":3,"parentId":null,"text":"Какво стана с катастрофата,която сътвори Кирил Петков \n❓\n🇧🇬\n Няма ли да бъде съден и вкаран в затвора \n❓","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":4,"parentId":null,"text":"Видя се що за българи са тия, алчни да пари и власт, и майка си ще продадат за пари.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":5,"parentId":null,"text":"Е сега драги ми избиратели какво ще кажете за любимите ви Гюров,Петков и другите приближени предатели ,какви са те?българи ли,за кого милеят,кого обслужват,облагодетелстват,долни мръсници за пари продавате родината,измет","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":"Мафиоти!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":7,"parentId":null,"text":null,"truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":8,"parentId":null,"text":"Национални предатели!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":9,"parentId":null,"text":"Предатели","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":10,"parentId":null,"text":"Предатели!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":11,"parentId":null,"text":"Истина е..\n😮","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":12,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":13,"parentId":null,"text":"Ама бъреков ти не печеш ли кебапчета за йотовица.....научи ли английския","truncated":false,"gyurov":"not-mentioned","yotova":"neutral"}]}
