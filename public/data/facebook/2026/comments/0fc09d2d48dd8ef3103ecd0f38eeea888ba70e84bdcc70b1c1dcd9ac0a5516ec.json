{"version":1,"collectionSha256":"6f731621aa7c0dfe30f562d52469d0ac47832acffde217c6ec47f56d896a5310","postId":"post:pfbid09m9SDJjCfAtU4pqLC9SBbnyHxx32WDQnEjS4xVs9oJ8Pd6BYFWfWZshFR3N9qoA6l","comments":[{"id":1,"parentId":null,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":2,"parentId":null,"text":"Гюров беше толкова смешен, на моменти будеше съжаление! Абе, с една дума, излагация!","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":3,"parentId":null,"text":"Браво за представянето на Йотова!!! \n❤️\n УСПЕХ!!! \n❤️\n🥰\n🍀\n🇧🇬\n🇧🇬","truncated":false,"gyurov":"not-mentioned","yotova":"supportive"},{"id":4,"parentId":null,"text":"Гюров е само пионката, която сглобкатджиите зад него ще местят в тяхна изгода. \nСамо за Йотова!","truncated":false,"gyurov":"critical","yotova":"supportive"},{"id":5,"parentId":null,"text":"Но някойи от народа не знаят и му гласуват","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"unclear"},{"id":7,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":8,"parentId":null,"text":"Благодаря за подкрепата ...","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":9,"parentId":null,"text":"Или 25 или украинската коалиция идва \nЯко","truncated":false,"gyurov":"not-mentioned","yotova":"supportive"},{"id":10,"parentId":null,"text":"Бареков и Йотова на един кантар! И двамата лъжат и мажат безпардонно и безочливо!","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":11,"parentId":2,"text":", какво съжаление , предполагам , че това също е пиар ход да го съжалят .","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":12,"parentId":3,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"supportive"},{"id":13,"parentId":2,"text":"И от съжаление да отидат да гласуват, и да имаме \"достоен\" Президент! Боже, пази!","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":14,"parentId":2,"text":", А НЕ  , не трябва да го допуснем .","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":15,"parentId":4,"text":"да","truncated":false,"gyurov":"critical","yotova":"supportive"},{"id":16,"parentId":null,"text":"Да гласуваме за Йотова в противен случай гласуваме за Борисов и Василев.","truncated":false,"gyurov":"not-mentioned","yotova":"supportive"},{"id":17,"parentId":null,"text":"Пак лъжи  \nПредизборни простотии....\nЩе ви идем с лъжите..","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":18,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":19,"parentId":null,"text":"Йотова беше смешна продължава да лъже местото и е в затвора при наркоманите 10 г. Да си ги излежи....","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":20,"parentId":null,"text":"В неделя всички гласуваме за Гюров и [име] с №4, за да няма повече такива помиловки.","truncated":false,"gyurov":"supportive","yotova":"critical"},{"id":21,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":22,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":23,"parentId":17,"text":"има една приказка каято се казва : \" лъжливото овчарче \". Андрюша е овчарчето!!","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":24,"parentId":20,"text":"прочети и се информирай, кои \"доктори\" са дали заключение...","truncated":false,"gyurov":"not-mentioned","yotova":"neutral"},{"id":25,"parentId":17,"text":"Всичко лъже и маже,\nНа всякъде ни знаят....!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"}]}
