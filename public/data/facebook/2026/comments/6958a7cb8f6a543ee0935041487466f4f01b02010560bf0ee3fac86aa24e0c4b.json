{"version":1,"collectionSha256":"6f731621aa7c0dfe30f562d52469d0ac47832acffde217c6ec47f56d896a5310","postId":"video:1094888736870133","comments":[{"id":1,"parentId":null,"text":"И за този [обида] има хора, които гласуват. ","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":2,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":3,"parentId":null,"text":"Научи се да говориш скапаняк","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":4,"parentId":null,"text":"И тоя ще става Президент е ебахти клитора","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":5,"parentId":null,"text":"Хора незнам на къде сме тръгнали \nКак може да показват  този\n[обида]  ….Кой гласува за него","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":"Нали си от партия ПП нали те.те издигат пълен плужек","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":7,"parentId":1,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":8,"parentId":1,"text":"споко пък ти мършляк","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":9,"parentId":2,"text":"а ти си самото плашило.\n😢\n😭\n😢\nТи го остави [име].Погледни се ти,че тогава коментирай другите.\n👎\n👎\n👎\n👎\n🤮\n🤮\n🤮\n🤮\n🤮","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":10,"parentId":5,"text":"Е, кой?????\nСъщите [обида]\nидиоти като него!!!!!!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":11,"parentId":5,"text":"що \n❓\n❓\n❓\nЙотова по жена ли ти се вижда \n😂\n😂\n😂","truncated":false,"gyurov":"not-mentioned","yotova":"critical"},{"id":12,"parentId":null,"text":"Тоя не става/Гюров не става","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":13,"parentId":null,"text":"И ЗА ТОЯ ТЪПАК СА ГЛАСУВАЛИ ДНЕС ....","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":14,"parentId":null,"text":".гюро, гюро, и ти си кандидат за президент.ЧИСТА ПОДЛОГА СИ.","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":15,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":16,"parentId":null,"text":"Петрохан","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":17,"parentId":null,"text":"Боклук,и тоя за президент","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":18,"parentId":null,"text":"Глупак!\n🙉","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":19,"parentId":null,"text":"ТИ СИ РЕАЛНО  [лично твърдение] БЕЗ РЕАЛНО МИСЛЕНЕ А С МОИТЕ КРИТЕРИИНИ НИ ХРЕН НЕ СТАВА ОТ ТЕБЕ А КАМО ЛИ ПРЕЗИДЕНТ !","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":20,"parentId":null,"text":"Ънкъмане мънкаме нищо на лице","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":21,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":22,"parentId":5,"text":"Йотова е 100 пъти по мъж от този хубавец\n[име]","truncated":false,"gyurov":"unclear","yotova":"supportive"},{"id":23,"parentId":5,"text":"Ами и аз това казах.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":24,"parentId":13,"text":"УКРАИНЦИТЕ СИГУРНО ГО ПОДКРЕПЯТ.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":25,"parentId":15,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":26,"parentId":19,"text":"и ти си тръгнал да плюваш,а за БУКВАР някога чувал ли си,виждал ли си \n👎\n👎\n👎\n👎\n👎\n👎\n😱\n🫣\n😱\n🫣\n😱","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":27,"parentId":20,"text":"толкова си може човека. Ами [име] и толкова не може \n😂","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":28,"parentId":null,"text":"ЛАЙНОТО ГЮРО!","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":29,"parentId":null,"text":"тоя дървеняк за чеп за зеле не става","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":30,"parentId":null,"text":"Паразити","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":31,"parentId":null,"text":"ПОМИЯР ДОЛЕН ПРЕДАТЕЛ НА БЪЛГАРИЯ","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":32,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":33,"parentId":null,"text":"Ако този човек стане  президент ще ни вкара във война с Русия. Този човек е опасен за България","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":34,"parentId":null,"text":"Боже мили тоя изобщо знаели какво мъка ъка\nТъп на галош да целува усраински знаме и да иска да е български президент.\nПомия си","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":35,"parentId":null,"text":"Неприятен,зловещ човек,тоя няма български манталитет,ако спечели ,ще платим жестоко,това е моето вътрешно усещане,не харесвам Йотова,но е по малкото зло,лично мнение,!!!!","truncated":false,"gyurov":"unclear","yotova":"mixed"},{"id":36,"parentId":null,"text":"Ей мършо!!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":37,"parentId":null,"text":"Този не знае къде се намира","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":38,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":39,"parentId":null,"text":"Пази Боже от такива управници.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":40,"parentId":null,"text":"Този има,,гримче\".Ойде коньо у реката.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":41,"parentId":null,"text":"Гъзолизец духач \n😀","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":42,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":43,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":44,"parentId":null,"text":"Уж вишист пък неможе да върже две приказки и тоя президент....Ужас....","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":45,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":46,"parentId":null,"text":"[обида] НЕЩАСТЕН!!! ТИ СИ ВЕЧЕ ПОЛИТИЧЕСКИ ТРУП.НО ВСЕ ОЩЕ НЕ СИ ГО ОСЪЗНАЛ !!!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":47,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":48,"parentId":null,"text":"Най-мразените политици трябва да управляват държавата, пък не най-малко Гюров. До къде сме я докарали…","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":49,"parentId":null,"text":"Крива муцуна","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":50,"parentId":null,"text":null,"truncated":true,"gyurov":"unclear","yotova":"not-mentioned"},{"id":51,"parentId":null,"text":"Изруд","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":52,"parentId":null,"text":"Жалка картинка","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":53,"parentId":null,"text":"Заради това каканижене за неговите критерии се отказвам да подкрепям....","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":54,"parentId":null,"text":"Nyznik","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":55,"parentId":null,"text":"Никой досега не го попитал Гюров имал ли е двойно гражданство и ако е служил в армията- точно в коя армия на коя държава е служил  ?","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":56,"parentId":null,"text":"Исклесяк","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":57,"parentId":null,"text":"Коолко е жалък тоя гюру !","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":58,"parentId":null,"text":"Тоя бил много прост.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":59,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":60,"parentId":null,"text":"ТОЭИ БОКЛУК НЕ ЭНАЕ\nКЬДЕ СЕ НАМИРА","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":61,"parentId":null,"text":"Ъ ъ ъ и нищо не каза и тоя ще ни става президент","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":62,"parentId":null,"text":"Между Гюров и [име] няма голяма разлика, но като си помисля, че тази комбинация ще представя страната ни, настръхвам.","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":63,"parentId":null,"text":"Няма грам мозък","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":64,"parentId":null,"text":"Мафиот мюслиманите нямада гласуват за Гюров получавате певски Борисов","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":65,"parentId":null,"text":"Мале мале мале ее и аз съм тръгнал да гласувам за този глупак.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":66,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":67,"parentId":null,"text":"ЧУДЯ СЕ ДОКОГА БЪЛГАРИТЕ ЩЕ ИЗБИРАТ [обида] ДА ГИ УПРАВЛЯВАТ","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":68,"parentId":null,"text":"Един позабравен запис. Къса памет имат българските избиратели! Асен Василев и Кирил Петков са „най-добрите лъжци!  Частта за „Ала-бала през президента“\n(Говори Кирил Петков, анализирайки изборните резултати)\nКирил Петков: „Каква е електоралната структура на България? В България и","truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":69,"parentId":null,"text":"ДЖУКИ ЗА ШАМАНДУРА И ПЕТРОХАНСКИ ГАЛОШ","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":70,"parentId":null,"text":"Сигурен ли е в това, което казва Гюров?","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":71,"parentId":null,"text":"Tozi a,a 6te ni rakovodi bravo.\n😂\n😂\n😂\n😂\n🔥\n🔥\n🔥\n🔥","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":72,"parentId":null,"text":"Ama samiya toy ne razbira kakvo govori  trybva da sme mnogo glupavi za da si dadem glasovete za tıkıf !!m","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":73,"parentId":null,"text":"Едно към едно са му критериите! Да го мислят гласувалите за този елемент!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":74,"parentId":null,"text":"Ах мръсен","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":75,"parentId":null,"text":"С тази крива уста става само за ...тромпетист а не и президент.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":76,"parentId":null,"text":"Те машините работят за тях .","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":77,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":78,"parentId":61,"text":"то и туша на миглите си размазал горкия","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":79,"parentId":68,"text":null,"truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":80,"parentId":68,"text":", идиот мамин нагъл, това е Божанков!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":81,"parentId":68,"text":"Жалко е, когато липсата на първите седем години и домашно възпитание си личи още от първата дума. На всичкото отгоре коментарът Ви е и напълно неграмотен – започвате със запетая и бъркате елементарни правила. Обидите и агресията са единственото оръжие на безси","truncated":true,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":82,"parentId":null,"text":"Хора не гласувайте за никого ! Това са боклуци, който управляват държавата, която я ограбиха.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":83,"parentId":null,"text":"Ти къв кенеф си Гюров!","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":84,"parentId":null,"text":"Екак може да гласуватеза този тапак","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":85,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":86,"parentId":null,"text":"И този [обида] за президент българския народ го иска.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":87,"parentId":null,"text":"Този ако стане президент ще е голяма трагедия за България","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":88,"parentId":null,"text":"Поредния пундек във власта, който неможе да се изкаже, ако няма написано, какво и как да говори","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":89,"parentId":null,"text":"Е това ли искате,браво","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":90,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":91,"parentId":null,"text":"Bokluk","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":92,"parentId":null,"text":"Куб!","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":93,"parentId":null,"text":"Слешник!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":94,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":95,"parentId":null,"text":"Този е голям [обида]!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":96,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":97,"parentId":null,"text":"И тоя [обида] иска да става президент,ако стане,жална ни майка!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":98,"parentId":null,"text":"Добре гримиран...миглите със спирала\n😂","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":99,"parentId":null,"text":"Мръсен [обида] който предаде България който подписа договор със Украйна 10 година който е предател но слава бого всичко си дойда на място миждутурка на Кукорчо Прасето и тиквата мръсни мутри предатели предадоха собствената си държава срам и позор.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":100,"parentId":null,"text":"Как си криви устата като говори ,затвор до живот на тебе и на целия парламент до чистача и готвача затвор до изгниване на кокали боклуци долни продажни","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":101,"parentId":null,"text":"ХИЛИ СЕ [обида]","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":102,"parentId":null,"text":"Върти,суче,по неговите критерии и накрая едно голямо НИЩО.И този г-н се кани да ни представлява пред света.\nПази Боже!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":103,"parentId":null,"text":"Тоя си е сложил спирала за очи !.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":104,"parentId":null,"text":"Буклук за затвора до живот","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":105,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":106,"parentId":null,"text":"Помияр това ли искате да вие президент бе","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":107,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":108,"parentId":null,"text":"Само този  НЕ.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":109,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":110,"parentId":null,"text":"Кривоуст мафиот","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":111,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":112,"parentId":null,"text":"Гюров е марионетка и слуга на ционистите. Русия била агресор, обаче неговите господари от Израел, които превърнаха Палестина в детско гробище, не са ли агресор?","truncated":false,"gyurov":"critical","yotova":"not-mentioned"},{"id":113,"parentId":null,"text":"Боклук!","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":114,"parentId":null,"text":"Кривата зурла боклук долен [обида]","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":115,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":116,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":117,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":118,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":119,"parentId":null,"text":"Както вие не сте спряли да лъжете и обиждате Гюро и кокорко, да видите хубаво ли е, боклуци.","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":120,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":121,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":122,"parentId":117,"text":"Затова е с Зеленски.","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":123,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":124,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":125,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":126,"parentId":null,"text":null,"truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":127,"parentId":null,"text":"Боклук","truncated":false,"gyurov":"unclear","yotova":"not-mentioned"},{"id":128,"parentId":null,"text":"Хора, за мислете се за децата си. Този пелтек ще ни вкара във война\n😮","truncated":false,"gyurov":"unclear",