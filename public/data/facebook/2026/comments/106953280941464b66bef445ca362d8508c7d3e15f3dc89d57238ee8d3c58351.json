{"version":1,"collectionSha256":"d46d0c538375d98f3652626c8bb4389128a07c50a674d11fff526e8c4cb749c4","postId":"post:pfbid0KisFpBdsttQ3mTPPqpPgaxPDyddQ5s6EuS3aFRAVTwBDYGCNnGDY8LDpYNn5ZkBZl","comments":[{"id":1,"parentId":null,"text":"Я кажи за спонсорите на Радев.","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":2,"parentId":1,"text":"сигурно гърмят кораби","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"},{"id":3,"parentId":1,"text":"А, на ГЮРОВ кои са спонсорите? Пък и не е ваша работа.Любопитсвото не е качество.","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":4,"parentId":1,"text":"на Гюров спонсорите са посочени. Аз питам за Радев. И не ми го залепвайте Гюров.","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":5,"parentId":1,"text":"[име] те са ясни ,както и на Гюру кво се опитваш да кажеш че не ти се разбира.","truncated":false,"gyurov":"neutral","yotova":"not-mentioned"},{"id":6,"parentId":null,"text":"Оставка на фатмака","truncated":false,"gyurov":"not-mentioned","yotova":"not-mentioned"}]}
