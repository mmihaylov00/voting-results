    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.2",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
